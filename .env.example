# IOT_DATA_ENDPOINT=YOUR_ENDPOINT-ats.iot.us-east-1.amazonaws.com
PORT=3000
# Set this in AWS/ECS to require Authorization: Bearer <token> on /api/*.
# API_AUTH_TOKEN=replace-with-a-long-random-secret
BATCH_WINDOW_MS=2000
MAX_MATCH_DISTANCE_KM=8
# Used to calculate rider-facing pickup and drop-off estimates at assignment time.
ETA_AVERAGE_SPEED_KMH=30
H3_RESOLUTION=8
MAX_VEHICLE_SPEED_KMH=130
