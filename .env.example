MONGO_URI=mongodb://localhost:27017
MONGO_DB=ride_matching
MQTT_URL=mqtts://a1891enpcqiqiu-ats.iot.us-east-1.amazonaws.com
MQTT_CLIENT_ID=vehicle-00001
AWS_REGION=us-east-1
TELEMETRY_TRANSPORT=mqtt
# TELEMETRY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/telemetry-ingest
RIDE_REQUEST_TRANSPORT=mqtt
MATCHING_TRANSPORT=mqtt
# RIDE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ride-requests
DISPATCH_TRANSPORT=mqtt
TRIP_TRANSPORT=mqtt
